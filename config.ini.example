# OBD 配置文件示例
# 复制此文件为 config.ini 并填入你的实际配置

# ================================
# 执行模式配置
# ================================
[EXECUTION_MODE]
# 运行模式选择（必需）
# standard: 标准问答模式（旧逻辑，支持简单问答评测）
# rag_eval: RAG 语义评测模式（新逻辑，支持评测范围和历史对比）
# dual_workflow_compare: 双工作流对比评测模式（对比两个工作流的答案质量）
mode = standard

# ================================
# 模式 A: 标准问答模式配置
# ================================
[SCHEMA_STANDARD]
# 问题列（必需）
col_question = Question

# 期望答案列（Ground Truth，必需）
col_ground_truth = Ground Truth

# 可选列（用于路由和评测分支）
col_knowledge_base = KNOWLEDGE_BASE
col_answer_state = ANSWER_STATE
col_feedback_answer = FEEDBACK_ANSWER

# ================================
# 模式 B: RAG 语义评测模式配置
# ================================
[SCHEMA_RAG_EVAL]
# 问题列（必需）
col_question = Question

# 评测范围列（必需）
# 内容示例: "仅关注参数完整性", "重点关注计算公式"
col_scope = Scope

# 上一版回答列（必需）
# 用于对比改进情况
col_ref_answer = Ref_Answer

# 历史评价列（必需）
# 内容示例: "部分缺失：缺少参数X和参数Y"
col_history_eval = Evaluation_Notes

# ================================
# 模式 C: 双工作流对比评测模式配置
# ================================
[SCHEMA_DUAL_WORKFLOW]
# 问题列（必需）
col_question = Question

# 历史回答列（可选）
# 如果有历史版本答案，可用于三方对比评测
col_history = Historical Answer

# ================================
# Dify API 配置
# ================================
[Dify]
# Dify API密钥（默认密钥，兼容旧模式）
# 格式: app-xxxxxxxxxxxxxxxx
# 请不要在此文件中填写真实密钥，复制后删除注释
api_key = app-hcYThYPXyCRKTniQU4iDwPNU

# Dify API基础URL
# 云端Dify: https://api.dify.ai/v1
# 本地Dify: http://localhost/v1
base_url = https://localhost/v1

# 响应模式：blocking（阻塞等待）或 streaming（流式响应）
# blocking: 等待完整响应
# streaming: 实时接收响应流
response_mode = blocking

# 请求超时时间（秒）
# 根据问题复杂度调整，默认60秒
timeout = 60

[WORKFLOW_MAPPING]
# 工作流映射表（新模式）
# 格式: 标准化知识库名称 = API Key
# 知识库名称会被自动标准化（去除空格，统一小写）
# 示例:
# workflow1 = app-api-key-for-workflow-1
# workflow 2 = app-api-key-for-workflow-2
# knowledge_base_a = app-api-key-for-knowledge-base-a
# diesel kb = app-api-key-for-diesel-kb

# ================================
# 双工作流配置（dual_workflow_compare 模式）
# 单工作流 + 双模型输出架构
# ================================
[DUAL_WORKFLOW]
# 单一工作流配置（API Key）
# Dify 工作流需要返回结构化的双模型输出：
# 问题：{{#sys.query#}}
# rerank后的片段：{{#...formatted_result#}}
# 经过llm1的结果：{{#...text#}}
# 经过llm2的结果：{{#...text#}}
api_key = app-your-api-key

# 工作流ID（可选）
# 如果要使用特定版本的工作流，请在此填写ID
workflow_id =

# 标签配置（用于结果展示）
label_1 = LLM1
label_2 = LLM2
label_history = 历史回答

# 共享配置
# Dify API基础URL
base_url = https://api.dify.ai/v1

# 响应模式：blocking（阻塞等待）或 streaming（流式响应）
response_mode = blocking

# 请求超时时间（秒）
timeout = 60

# ================================
# 工作流配置
# ================================
[Workflow]
# 工作流ID（可选）
# 如果要使用特定版本的工作流，请在此填写ID
# workflow_id = your-workflow-id-here

# 处理并发数
# 默认 5，建议根据 API 速率限制调整（5-20）
max_workers = 5

# 工作流输入变量名
# 确保与Dify工作流中定义的输入变量名一致
input_variable_name = query

# 工作流输出变量名
# 确保与Dify工作流输出的变量名一致
output_variable_name = answer

# 答案对比方法
# exact: 精确匹配（忽略大小写和空格）
# fuzzy: 模糊匹配（相似度≥0.8）
# keyword: 关键词匹配（提取关键词检查包含关系）
# auto: 自动选择（按exact → fuzzy → keyword顺序尝试）
comparison_method = auto

# 每次请求之间的延迟（秒）
# 避免API限流，推荐0.5-1.0秒
delay = 0.5

# ================================
# LLM 评测配置
# ================================
[LLM_EVAL]
# 是否启用 LLM 评测
# true: 启用 LLM 评测，完全依赖 LLM 判断答案是否正确
# false: 禁用 LLM 评测，不进行评测
enabled = false

# OpenAI 兼容 API Key
api_key = sk-your-api-key-here

# API 完整地址（包含 /chat/completions 路径）
# 程序不会自动拼接路径，请配置完整的 API 端点
#
# 常用示例:
# OpenAI:    https://api.openai.com/v1/chat/completions
# DeepSeek:  https://api.deepseek.com/v1/chat/completions
# Azure:     https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-02-15-preview
base_url = https://api.openai.com/v1/chat/completions

# 使用的模型
model = gpt-4o

# API 类型（必需）
# standard: 标准 OpenAI 格式（使用 messages 输入，choices 输出）
# custom_azure: 特殊 Azure 代理格式（使用 input 输入，output 输出）
api_type = custom_azure

# 请求超时时间（秒）
timeout = 30

# LLM 判断模式
# detailed: 详细标准模式，在提示词中明确定义每种错误类型的判断标准
# autonomous: 自主判断模式，只告诉 LLM 判断原则，由 LLM 根据语义自主决定
judgment_mode = detailed

# LLM 温度参数（0.0-1.0，控制输出的确定性，0.0 最确定）
temperature = 0.0

# 是否在 Excel 中保存完整 LLM 提示词（调试用）
# true: 在输出 Excel 中新增"LLM 评测提示词"列，显示发送给 LLM 的完整提示词
# false: 不保存提示词，减少 Excel 文件大小
save_prompt = false

# 是否启用评测记录（新增）
# true: 将每次 LLM 评测的输入输出保存为 JSON 文件，用于调试和分析
# false: 不保存评测记录
eval_record_enabled = false

# 评测记录保存路径（新增）
# 记录将按时间戳分文件夹存储，每个问题一个 JSON 文件
# 相对或绝对路径，如：logs/eval_records
eval_record_path = logs/eval_records

# ================================
# 输出配置
# ================================
[Output]
# 结果输出文件路径
# 将生成包含详细处理结果和统计信息的Excel文件
file_path = results.xlsx

# Excel文件路径（相对或绝对路径）
# 支持 .xlsx 和 .csv 格式
input_file_path = questions.xlsx
